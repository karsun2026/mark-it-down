APP_ENV=development

# Size ceilings (§42)
MAX_UPLOAD_MB=100
MAX_OUTPUT_TREE_MB=180
MAX_RESULT_ZIP_MB=180

# Global across all in-flight jobs on one instance, NOT per job.
# See DEVIATIONS.md D-001 before raising either of these.
MAX_TMP_WORKSPACE_MB=425
MAX_LOCAL_CONCURRENT_CONVERSIONS=1

CONVERSION_TIMEOUT_SECONDS=690
PANDOC_TIMEOUT_SECONDS=345

# Office archive safety (§30)
MAX_ARCHIVE_MEMBERS=10000
MAX_OFFICE_UNCOMPRESSED_MB=350
MAX_COMPRESSION_RATIO=100

# Signed URL lifetimes (§42) - Phase 2
SIGNED_SOURCE_URL_MINUTES=20
SIGNED_RESULT_PUT_URL_MINUTES=20
SIGNED_DOWNLOAD_URL_MINUTES=10

# Retention (§40) - Phase 2
SOURCE_BLOB_MAX_AGE_MINUTES=60
RESULT_BLOB_MAX_AGE_MINUTES=120

# Minimum 32 random bytes. Never commit a real value.
JOB_SIGNING_SECRET=replace-with-long-random-secret

AUTH_MODE=none
LOG_FILENAMES=false

# Local development only. Leave unset in the container, where pandoc is on PATH.
# PANDOC_BIN=pandoc
# WORKSPACE_ROOT=/tmp/doc2md
