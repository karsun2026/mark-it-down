APP_ENV=development

# Size ceilings (§42)
MAX_UPLOAD_MB=100
MAX_OUTPUT_TREE_MB=180
MAX_RESULT_ZIP_MB=180

# Global across all in-flight jobs on one instance, NOT per job.
# See DEVIATIONS.md D-001 before raising either of these.
MAX_TMP_WORKSPACE_MB=425
MAX_LOCAL_CONCURRENT_CONVERSIONS=1

CONVERSION_TIMEOUT_SECONDS=690
PANDOC_TIMEOUT_SECONDS=345

# Office archive safety (§30)
MAX_ARCHIVE_MEMBERS=10000
MAX_OFFICE_UNCOMPRESSED_MB=350
MAX_COMPRESSION_RATIO=100

# Signed URL lifetimes (§42) - Phase 2
SIGNED_SOURCE_URL_MINUTES=20
SIGNED_RESULT_PUT_URL_MINUTES=20
SIGNED_DOWNLOAD_URL_MINUTES=10

# Retention (§40) - Phase 2
SOURCE_BLOB_MAX_AGE_MINUTES=60
RESULT_BLOB_MAX_AGE_MINUTES=120

# Minimum 32 random bytes. Never commit a real value.
JOB_SIGNING_SECRET=replace-with-long-random-secret

AUTH_MODE=none
LOG_FILENAMES=false

# Local development only. Leave unset in the container, where pandoc is on PATH.
# PANDOC_BIN=pandoc
# WORKSPACE_ROOT=/tmp/doc2md

# Blob webhook verification for the presigned upload flow (DEVIATIONS D-004)
BLOB_WEBHOOK_PUBLIC_KEY=

# Protects the hourly cleanup route (§41). Vercel Cron sends it as a bearer token.
CRON_SECRET=replace-with-long-random-secret

# --- Amendment 01 additions ---

# A1.6 - the in-process converters (PPTX, PDF) run in a killable child process.
# Keep below CONVERSION_TIMEOUT_SECONDS so the parent can still clean up.
PPTX_CONVERSION_TIMEOUT_SECONDS=600

# A1.3 - speaker notes routinely contain internal commentary. Opt in only.
PPTX_INCLUDE_NOTES=false

# A2.3 - table extraction is a budgeted, degradable feature.
PDF_TABLE_EXTRACTION=true
PDF_TABLE_MAX_PAGES=300
PDF_TABLE_PAGE_TIMEOUT_SECONDS=5
PDF_TABLE_DEADLINE_RESERVE_SECONDS=90

# --- Phase 5: auth and rate limiting ---

# §43. Modes: none | password | entra.
#   none      development only - the app is OPEN
#   password  one shared password at the door (current production setting)
#   entra     Microsoft Entra ID (needs an app registration)
# Setting APP_PASSWORD implies `password` even if AUTH_MODE is unset, so one
# variable is enough to lock the app down.
AUTH_MODE=none
# The access password. Server-side only; never sent to the browser.
# APP_PASSWORD=
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# §44. Requires a Vercel Firewall rule with this id:
#   Dashboard -> Firewall -> Configure -> New Rule
#   If: @vercel/firewall, Rate limit ID: conversions
#   Then: Rate Limit, Fixed Window, 600s window, 5 requests
# Without that rule the SDK returns error='not-found' and NOTHING is limited;
# the app logs "rate limiting is NOT in effect" on every request.
RATE_LIMIT_ENABLED=true
# Set true to REFUSE requests when the limiter is misconfigured, instead of
# letting them through. Safer, but a transient Firewall fault becomes an outage.
RATE_LIMIT_REQUIRED=false
